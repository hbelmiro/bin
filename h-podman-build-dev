#!/usr/bin/env zsh

PATH=".:$PATH"

IMAGE_NAME=""
USE_DOCKER=false

while getopts "d" opt; do
  case $opt in
    d)
      USE_DOCKER=true
      ;;
    \?)
      echo "Invalid option: -$OPTARG" >&2
      exit 1
      ;;
  esac
done

if [ "$USE_DOCKER" = true ]; then
  IMAGE_NAME=$2
else
  IMAGE_NAME=$1
fi

TIMESTAMP=$(date +%s)
CURRENT_BRANCH=$(git branch --show-current)

# Optional OCI platform (e.g. linux/amd64 for OpenShift). Unset = host default.
TARGETARCH="${TARGETARCH:-amd64}"
PLATFORM_FLAG=()
if [[ -n "${CONTAINER_PLATFORM:-}" ]]; then
  PLATFORM_FLAG=(--platform "${CONTAINER_PLATFORM}")
fi

BUILDER_ARCH_FLAG=()
if [[ -n "${BUILDER_ARCH:-}" ]]; then
  BUILDER_ARCH_FLAG=(--build-arg "BUILDER_ARCH=${BUILDER_ARCH}")
fi

if [ "$USE_DOCKER" = true ]; then
  FULL_IMAGE_NAME="docker.io/hbelmiro/${IMAGE_NAME}:dev-${CURRENT_BRANCH//\//_}-${TIMESTAMP}"
  if podman build "${PLATFORM_FLAG[@]}" \
    --build-arg TARGETOS=linux --build-arg TARGETARCH="${TARGETARCH}" \
    --build-arg "FIPS_ENABLED=${FIPS_ENABLED:-0}" "${BUILDER_ARCH_FLAG[@]}" -t "${FULL_IMAGE_NAME}" . > /dev/null; then
    echo "${FULL_IMAGE_NAME}"
  else
    echo "Docker build failed."
    exit 1
  fi
else
  FULL_IMAGE_NAME=quay.io/hbelmiro/"${IMAGE_NAME}":dev-"${CURRENT_BRANCH//\//_}"-"${TIMESTAMP}"
  if podman build "${PLATFORM_FLAG[@]}" \
    --build-arg TARGETOS=linux --build-arg TARGETARCH="${TARGETARCH}" \
    --build-arg "FIPS_ENABLED=${FIPS_ENABLED:-0}" "${BUILDER_ARCH_FLAG[@]}" -t "${FULL_IMAGE_NAME}" . > /dev/null; then
    echo "${FULL_IMAGE_NAME}"
  else
    echo "Quay container build failed."
    exit 1
  fi
fi
